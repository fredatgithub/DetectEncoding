<Window x:Class="DetectEncoding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DetectEncoding"
        mc:Ignorable="d"
        Title="Detect Encoding" Height="450" Width="800">
    <Grid>
    <StackPanel Margin="20">

      <Button Content="Sélectionner un fichier"
                Height="35"
                Click="BtnDetecter_Click"/>

      <TextBlock x:Name="TxtFichier"
                   Margin="0,20,0,10"
                   TextWrapping="Wrap"/>

      <TextBlock x:Name="TxtEncodage"
                   FontSize="16"
                   FontWeight="Bold"/>

      <TextBlock x:Name="TxtConfiance"
                   Margin="0,10,0,0"/>

      <TextBox x:Name="TxtContenu"
                 Margin="0,20,0,0"
                 Height="90"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"/>

    </StackPanel>

  </Grid>
</Window>
