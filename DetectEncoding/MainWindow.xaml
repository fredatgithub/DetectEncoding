<Window x:Class="DetectEncoding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DetectEncoding"
        mc:Ignorable="d"
        Title="Detect Encoding" Height="450" Width="800">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Button Grid.Row="0"
                Content="Sélectionner un fichier"
                Height="35"
                Click="BtnDetecter_Click"/>

    <TextBlock Grid.Row="1"
                   x:Name="TxtFichier"
                   Margin="0,20,0,10"
                   TextWrapping="Wrap"/>

    <TextBlock Grid.Row="2"
                   x:Name="TxtEncodage"
                   FontSize="16"
                   FontWeight="Bold"/>
    <TextBlock Grid.Row="3" x:Name="TxtConfiance" Margin="0,20,0,0"/>

    <TextBox Grid.Row="4"
                 x:Name="TxtContenu"
                 Margin="0,20,0,0"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"/>

  </Grid>
</Window>
